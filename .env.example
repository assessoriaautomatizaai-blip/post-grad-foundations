# Copie para .env e preencha. NUNCA versione o .env.
# Em produção, cadastre estes valores nos segredos do Lovable, não no código.

# Evolution API (canal WhatsApp)
EVOLUTION_API_URL=https://sua-instancia-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo compartilhado para validar que o webhook veio da sua instância Evolution
WEBHOOK_SECRET=

# Gemini (Google Gemini API, plano pago) — ver ADR-003
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Recuperação: abaixo deste escore o agente se abstém (ver ADR-004)
RETRIEVAL_MIN_SCORE=
